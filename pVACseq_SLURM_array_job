#CECI cluster
## Bash scripting

##1. One-time setup
#1.1 Install micromamba

cd ~
curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba
mkdir -p ~/micromamba
mv bin/micromamba ~/micromamba/
rmdir bin 2>/dev/null

export MAMBA_ROOT_PREFIX=~/micromamba
eval "$(~/micromamba/micromamba shell hook -s bash)"
#Make this persistent by adding to ~/.bashrc:

echo 'export MAMBA_ROOT_PREFIX=~/micromamba' >> ~/.bashrc
echo 'eval "$(~/micromamba/micromamba shell hook -s bash)"' >> ~/.bashrc

#1.2 Create the environment (Python 3.10)
micromamba create -n pvactools_env python=3.10 -c conda-forge -y
micromamba activate pvactools_env

#1.3 Install pvactools
pip install --upgrade pip
pip install "setuptools<81"    # keeps pkg_resources available (removed in setuptools >=81)
pip install pvactools

#1.4 Fix TensorFlow/Keras compatibility (needed for MHCflurry)

#The default TensorFlow pulled in was too new (2.21.0) and broke MHCflurry's legacy Keras backend call. Pin to a compatible version:

pip install "tensorflow==2.15.1"

#Verify:
python -c "from tensorflow.compat.v1.keras.backend import backend; print(backend())"
# should print: tensorflow
#Note: with this TF pin, you do not need TF_USE_LEGACY_KERAS=1 in your job scripts.


#1.5 Download MHCflurry trained models
mhcflurry-downloads fetch

#1.6 Install IEDB standalone tools (for NetMHCpan / NetMHCIIpan)
mkdir -p ~/iedb
cd ~/iedb

# Class I
wget https://downloads.iedb.org/tools/mhci/<version>/IEDB_MHC_I-<version>.tar.gz
tar -zxvf IEDB_MHC_I-<version>.tar.gz
cd mhc_i
./configure          # class I uses a `configure` shell script
cd ..

# Class II
wget https://downloads.iedb.org/tools/mhcii/<version>/IEDB_MHC_II-<version>.tar.gz
tar -zxvf IEDB_MHC_II-<version>.tar.gz
cd mhc_ii
python configure.py  # class II uses a `configure.py` script
cd ..

#Check the pVACtools install page for current version numbers/URLs before downloading. Both mhc_i and mhc_ii must live under the same parent directory (~/iedb), which is passed to pvacseq via --iedb-install-directory.

##2.Input files
#Sample/HLA list (all_samples_hla.tsv, tab-separated, header row):
  #Sample	HLA_alleles
  #BL1	HLA-A*02:13,HLA-A*02:74,HLA-B*08:01,HLA-B*38:01,HLA-C*07:01,HLA-C*12:03
  
#VCFs: one per sample, in vep_snv_with_GT_and_GX/, named <sample>.filtered.vep.gt.expr.vcf.

##3. SLURM array job script

#Save as pvacseq_array.sh:

#!/bin/bash
#SBATCH --job-name=pvacseq_array
#SBATCH --array=1-113%10          # 113 samples, 10 running concurrently — adjust as needed
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=04:00:00
#SBATCH --output=logs/pvacseq_%A_%a.out
#SBATCH --error=logs/pvacseq_%A_%a.err

# activate micromamba environment
export MAMBA_ROOT_PREFIX=~/micromamba
eval "$(~/micromamba/micromamba shell hook -s bash)"
micromamba activate pvactools_env

export CUDA_VISIBLE_DEVICES=""

TSV=/path/to/all_samples_hla.tsv
VCF_DIR=/path/to/vep_snv_with_GT_and_GX
OUT_DIR=/path/to/pvacseq_output
IEDB_DIR=~/iedb

# +1 skips the header row; SLURM_ARRAY_TASK_ID selects the data row
LINE=$(tail -n +2 "$TSV" | sed -n "${SLURM_ARRAY_TASK_ID}p")
sample=$(echo "$LINE" | cut -f1)
hla=$(echo "$LINE" | cut -f2)

pvacseq run \
    ${VCF_DIR}/${sample}.filtered.vep.gt.expr.vcf \
    TUMOR \
    ${hla} \
    MHCflurry MHCflurryEL NetMHCpan NetMHCpanEL NetMHCIIpan NetMHCIIpanEL \
    ${OUT_DIR}/${sample} \
    -e1 8,9,10,11 \
    -e2 12,13,14,15,16,17,18 \
    --pass-only \
    -t 4 \
    --iedb-install-directory ${IEDB_DIR}
##4. submitting and monitoring
mkdir -p logs
N=$(tail -n +2 /path/to/all_samples_hla.tsv | wc -l)
sbatch --array=1-${N}%10 pvacseq_array.sh
squeue -u $USER

#Check how many samples have actually finished
ls pvacseq_output/*/*.all_epitopes.aggregated.tsv 2>/dev/null | wc -l
#check for the errors/failures
grep -l "Error\|Traceback" logs/pvacseq_*_*.err 2>/dev/null
comm -23 <(tail -n +2 all_samples_hla.tsv | cut -f1 | sort) <(find pvacseq_output -iname "*.all_epitopes.aggregated.tsv" | sed -E 's#pvacseq_output/([^/]+)/.*#\1#' | sort -u)
