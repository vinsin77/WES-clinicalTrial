#CECI cluster
## Bash scripting

##1. One-time setup
#1.1 Install micromamba

cd ~
curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba
mkdir -p ~/micromamba
mv bin/micromamba ~/micromamba/
rmdir bin 2>/dev/null

export MAMBA_ROOT_PREFIX=~/micromamba
eval "$(~/micromamba/micromamba shell hook -s bash)"
#Make this persistent by adding to ~/.bashrc:

echo 'export MAMBA_ROOT_PREFIX=~/micromamba' >> ~/.bashrc
echo 'eval "$(~/micromamba/micromamba shell hook -s bash)"' >> ~/.bashrc

#1.2 Create the environment (Python 3.10)
micromamba create -n pvactools_env python=3.10 -c conda-forge -y
micromamba activate pvactools_env

#1.3 Install pvactools
pip install --upgrade pip
pip install "setuptools<81"    # keeps pkg_resources available (removed in setuptools >=81)
pip install pvactools

#1.4 Fix TensorFlow/Keras compatibility (needed for MHCflurry)

#The default TensorFlow pulled in was too new (2.21.0) and broke MHCflurry's legacy Keras backend call. Pin to a compatible version:

pip install "tensorflow==2.15.1"

#Verify:
python -c "from tensorflow.compat.v1.keras.backend import backend; print(backend())"
# should print: tensorflow
#Note: with this TF pin, you do not need TF_USE_LEGACY_KERAS=1 in your job scripts.


#1.5 Download MHCflurry trained models
mhcflurry-downloads fetch

#1.6 Install IEDB standalone tools (for NetMHCpan / NetMHCIIpan)
mkdir -p ~/iedb
cd ~/iedb

# Class I
wget https://downloads.iedb.org/tools/mhci/<version>/IEDB_MHC_I-<version>.tar.gz
tar -zxvf IEDB_MHC_I-<version>.tar.gz
cd mhc_i
./configure          # class I uses a `configure` shell script
cd ..

# Class II
wget https://downloads.iedb.org/tools/mhcii/<version>/IEDB_MHC_II-<version>.tar.gz
tar -zxvf IEDB_MHC_II-<version>.tar.gz
cd mhc_ii
python configure.py  # class II uses a `configure.py` script
cd ..

#Check the pVACtools install page for current version numbers/URLs before downloading. Both mhc_i and mhc_ii must live under the same parent directory (~/iedb), which is passed to pvacseq via --iedb-install-directory.

